# ==========================================
# GUARDIAHEXBOT - CONFIGURACIÓN DE EJEMPLO
# ==========================================

# Aplicación
APP_NAME=GUARDIAHEXBOT
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8100

# Seguridad
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base de datos
DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/guardiahex

# GUARDIAHEXBOT principal
MASTER_BOT_TOKEN=
SUPERADMIN_TELEGRAM_ID=

# API FuentesData
FUENTESDATA_ENABLED=false
FUENTESDATA_BASE_URL=
FUENTESDATA_TOKEN=
FUENTESDATA_TIMEOUT=30

# Historial global
GLOBAL_HISTORY_CHAT_ID=

# Compra / venta global
GLOBAL_SALES_CHAT_ID=

# Sistema
DEFAULT_REGISTER_CREDITS=5
MAX_FOUNDERS_PER_BOT=4

# Tiempo real
WEBSOCKET_ENABLED=true

# Archivos
UPLOAD_DIR=uploads
REPORT_DIR=reports
MAX_UPLOAD_MB=20

# Zona horaria
TIMEZONE=America/Lima
